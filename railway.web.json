{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "/app/**",
      "/components/**",
      "/packages/flaunch/**",
      "/packages/shared/**",
      "/public/**",
      "/package.json",
      "/package-lock.json",
      "/next.config.ts",
      "/postcss.config.mjs",
      "/tsconfig.json",
      "/vite.config.ts",
      "/railway.web.json"
    ]
  },
  "deploy": {
    "startCommand": "NODE_ENV=production npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
